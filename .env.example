# what: the template for .env. Copy it, fill it in, never commit the copy.
# why:  .env is in .gitignore; this file is not. A teammate cloning the repo
#       gets the shape of the configuration without ever getting a secret, and
#       nobody has to guess which variables exist.
# how:  copy to .env and fill in ONE of the two blocks below.

# ---- the course gateway (preferred: ask Luis for the two CF values) ---------
LLM_BASE_URL=https://ia.pezcol.dev/v1
LLM_MODEL=llm-luis
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ---- or the team's own OpenAI key (this one spends the USD 40) --------------
# Comment out the gateway block above if you use this one.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# OPENAI_API_KEY=
